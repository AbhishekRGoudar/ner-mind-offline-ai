{
  "8f109476723d3f4c8f4a93c5bf3b68f0": {
    "text": "ನಮಸ್ಕಾರ, ನಾನು ನಿಮಗೆ ಸಹಾಯ ಮಾಡಲು ಇಲ್ಲಿದ್ದೇನೆ.",
    "file": "8f109476723d3f4c8f4a93c5bf3b68f0.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "8d9d62fa81062287268377686ff14483": {
    "text": "ನಮಸ್ಕಾರ ಶರ್ಮಾ ಅವರೇ. ಕನ್ನಡದಲ್ಲಿ ಧ್ವನಿ ಸಹಾಯ ಸಕ್ರಿಯವಾಗಿದೆ.",
    "file": "8d9d62fa81062287268377686ff14483.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "869ef3824a63c102c69bbd1e98178439": {
    "text": "ನಮಸ್ಕಾರ. ಕನ್ನಡದಲ್ಲಿ ಧ್ವನಿ ಸಹಾಯ ಸಕ್ರಿಯವಾಗಿದೆ.",
    "file": "869ef3824a63c102c69bbd1e98178439.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "b261516103ec111cf73e5c60db5e3fd3": {
    "text": "ನಮಸ್ಕಾರ ಭಬೇನ್ ಶರ್ಮಾ ಅವರೇ. ಇಂದು ನಿಮ್ಮ ದೈನಂದಿನ ತರಬೇತಿಯನ್ನು ಪ್ರಾರಂಭಿಸೋಣ.",
    "file": "b261516103ec111cf73e5c60db5e3fd3.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "55c6c4e367b9ef00eb5e45a0e520f593": {
    "text": "ನಮಸ್ಕಾರ. ಇಂದು ನಿಮ್ಮ ದೈನಂದಿನ ತರಬೇತಿಯನ್ನು ಪ್ರಾರಂಭಿಸೋಣ.",
    "file": "55c6c4e367b9ef00eb5e45a0e520f593.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "e477d69d27963ab3984a17740078b229": {
    "text": "ಈ ವಸ್ತುಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ನೋಡಿ ಮತ್ತು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಿ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ನೀವು ಇವುಗಳನ್ನು ಗುರುತಿಸಬೇಕು.",
    "file": "e477d69d27963ab3984a17740078b229.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "6c8c5a8cff9ea63ea083e41a6f699126": {
    "text": "ಪರದೆಯ ಮೇಲೆ ಸರಿಯಾದ ಹೊಂದಾಣಿಕೆಯ ವಸ್ತುವನ್ನು ಗುರುತಿಸಿ ಸ್ಪರ್ಶಿಸಿ.",
    "file": "6c8c5a8cff9ea63ea083e41a6f699126.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "1200f99e8ffde3ea3f0105ac6a34c1a6": {
    "text": "ದೈನಂದಿನ ಕಾರ್ಯಗಳ ಹಂತಗಳನ್ನು ಸರಿಯಾದ ಅನುಕ್ರಮದಲ್ಲಿ ಜೋಡಿಸಿ.",
    "file": "1200f99e8ffde3ea3f0105ac6a34c1a6.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "f8e7b86f9cfff3adf08280e79fd51b26": {
    "text": "ಮಾರುಕಟ್ಟೆಯ ವಸ್ತುಗಳ ಒಟ್ಟು ಮೊತ್ತವನ್ನು ಲೆಕ್ಕಹಾಕಿ.",
    "file": "f8e7b86f9cfff3adf08280e79fd51b26.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "84ad23c255f2f48237df64e0b7389b3d": {
    "text": "ಈ ದಿನಚರಿಯಲ್ಲಿ ಮೊದಲು ಏನು ಮಾಡಬೇಕೆಂದು ಯೋಚಿಸಿ ಆಯ್ಕೆಮಾಡಿ.",
    "file": "84ad23c255f2f48237df64e0b7389b3d.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "d5d6cc5d7f3b320fbb418cb0fd33ee50": {
    "text": "ನಿಮ್ಮ ಪರಿಚಿತ ವ್ಯಕ್ತಿ ಅಥವಾ ವಸ್ತುವನ್ನು ಗುರುತಿಸಿ ಸರಿಯಾದ ಆಯ್ಕೆ ಮಾಡಿ.",
    "file": "d5d6cc5d7f3b320fbb418cb0fd33ee50.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "9f0b6e3eb0ce19011f3522b60a0988aa": {
    "text": "ದಯವಿಟ್ಟು ನಿಗದಿಪಡಿಸಿದ ಚಟುವಟಿಕೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
    "file": "9f0b6e3eb0ce19011f3522b60a0988aa.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "fcdab62b85def7ff9180fef755bba63a": {
    "text": "ನೈಜ ಜೀವನದ ಕಾರ್ಯ: Morning Tea Routine. ವಸ್ತುಗಳನ್ನು ನೆನಪಿಸಿಕೊಂಡು ಪಟ್ಟಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
    "file": "fcdab62b85def7ff9180fef755bba63a.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "34587c5119e29d742c72600866b26f32": {
    "text": "ನೈಜ ಜೀವನದ ಕಾರ್ಯ: Daily Routine. ವಸ್ತುಗಳನ್ನು ನೆನಪಿಸಿಕೊಂಡು ಪಟ್ಟಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
    "file": "34587c5119e29d742c72600866b26f32.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "982b1568a9c9e10f65fb51d746c8c4c2": {
    "text": "ನೈಜ ಜೀವನದ ಕಾರ್ಯ: Local Market Shopping. ವಸ್ತುಗಳನ್ನು ನೆನಪಿಸಿಕೊಂಡು ಪಟ್ಟಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
    "file": "982b1568a9c9e10f65fb51d746c8c4c2.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "56a5b4d036c21270fdf297cf30eb167e": {
    "text": "ತುಂಬಾ ಒಳ್ಳೆಯ ಕೆಲಸ! ನಿಮ್ಮ ಉತ್ತರ ಸರಿಯಾಗಿದೆ.",
    "file": "56a5b4d036c21270fdf297cf30eb167e.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "b6cf2bc1533d242626fd58ea21a15d2d": {
    "text": "ಉತ್ತಮ ಪ್ರಯತ್ನ. ಮುಂದಿನ ಪ್ರಶ್ನೆಯನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಮುಂದುವರಿಸೋಣ.",
    "file": "b6cf2bc1533d242626fd58ea21a15d2d.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "4c7d74f7758049c2dab4762b0dc95ebb": {
    "text": "ಅಭ್ಯಾಸ ಪೂರ್ಣಗೊಂಡಿದೆ! ನಿಮ್ಮ ಪ್ರಗತಿ ಉತ್ತಮವಾಗಿದೆ.",
    "file": "4c7d74f7758049c2dab4762b0dc95ebb.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "96fe561fe1dd416bbe43eeccb93c4664": {
    "text": "ನಮಸ್ಕಾರ, ನನಗೆ ಸಹಾಯ ಬೇಕು",
    "file": "96fe561fe1dd416bbe43eeccb93c4664.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "4914015db5c9fe94afdb4194c1837c73": {
    "text": "ಇಂದಿನ ಆಟಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ",
    "file": "4914015db5c9fe94afdb4194c1837c73.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "e4e1a41e8330d732a883850bd454d470": {
    "text": "ನನ್ನ ನೆನಪೋಲೆಗಳನ್ನು ಓದಿ",
    "file": "e4e1a41e8330d732a883850bd454d470.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "ade3f740542a4a39de6376b7f18a5b67": {
    "text": "ಹೌದು, ಸರಿ",
    "file": "ade3f740542a4a39de6376b7f18a5b67.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "037bd52350c73c485067d4c7e1b02a51": {
    "text": "ನಾನು ನಿಮ್ಮ ಧ್ವನಿಯನ್ನು ಕೇಳಿಸಿಕೊಂಡೆ. ನಿಮ್ಮ ಧ್ವನಿ ಸ್ಪಷ್ಟವಾಗಿ ಕೇಳಿಸುತ್ತಿದೆ.",
    "file": "037bd52350c73c485067d4c7e1b02a51.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "7ba5b9c77675e25e10954020caf0de38": {
    "text": "ಸರಿಯಾದ ಉತ್ತರ",
    "file": "7ba5b9c77675e25e10954020caf0de38.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "d38a848e9127f5fc133f69d2bc604212": {
    "text": "ತಪ್ಪಾದ ಉತ್ತರ",
    "file": "d38a848e9127f5fc133f69d2bc604212.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "2c708298ed85c27182e23e39465cceba": {
    "text": "ಮುಂದಿನ ಪ್ರಶ್ನೆ",
    "file": "2c708298ed85c27182e23e39465cceba.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  },
  "3bd638e14b230ce148505059dd18c5aa": {
    "text": "ತರಬೇತಿ ಮುಕ್ತಾಯ",
    "file": "3bd638e14b230ce148505059dd18c5aa.mp3",
    "voice": "kn-IN-SapnaNeural",
    "lang": "kn"
  }
}