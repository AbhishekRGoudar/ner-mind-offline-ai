# ==============================================================================
# NER-Mind — Production & Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port
PORT=4000

# Server Database Connection URL (PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[require|disable]
DATABASE_URL=postgresql://ner_admin:CHANGE_THIS_IN_PRODUCTION_PASSWORD@localhost:5432/ner_mind?sslmode=disable

# CORS Allowed Origins (Comma-separated for multiple origins, or single origin)
# In production, restrict strictly to the patient/caregiver PWA domain
CORS_ORIGIN=https://ner-mind.assam.gov.in,http://localhost:3000

# Frontend Base URL (used in API responses or absolute callbacks)
FRONTEND_URL=https://ner-mind.assam.gov.in

# Session Secret / Salt for Key Derivation (Use a cryptographically secure random string >= 32 chars)
SESSION_SECRET=CHANGE_THIS_RANDOM_SECRET_KEY_MIN_32_CHARS_LONG

# Session Lifetime in Milliseconds (Default: 4 hours)
SESSION_TTL_MS=14400000

# Rate Limiter Thresholds
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Client (Vite) API Target URL
# Leave blank when served behind the same reverse proxy / relative path
VITE_API_URL=
