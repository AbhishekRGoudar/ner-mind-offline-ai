# ==============================================================================
# @ner-mind/patient-app Environment Configuration (.env.example)
# Vite client-side environment variables must start with VITE_
# WARNING: NEVER PLACE SECRETS OR SENSITIVE TOKENS IN VITE ENVIRONMENT VARIABLES
# ==============================================================================

# Backend API base URL
# Leave empty if the PWA is hosted behind the same reverse proxy / domain
# Example: https://api.ner-mind.assam.gov.in
VITE_API_URL=

# Application Title
VITE_APP_TITLE=NER-Mind: Cognitive & Memory Companion
