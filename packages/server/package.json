{
  "name": "@ner-mind/server",
  "version": "1.0.0",
  "private": true,
  "description": "Caregiver backend API, sync service, and OWASP ASVS 5.0 security baseline for SIH 26003",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "verify:postgres": "tsx scripts/verifyPostgresIntegration.ts",
    "test": "vitest run --pool=forks"
  },
  "dependencies": {
    "@ner-mind/core": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
